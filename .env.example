# Copier ce fichier en .env et renseigner les valeurs de votre projet Supabase.
# La clé publishable est publique par nature (elle est incluse dans le bundle client) ;
# la sécurité repose sur le Row Level Security (RLS) activé côté Supabase.
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
